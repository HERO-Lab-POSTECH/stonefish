//N_BINS - number of histogram bins
//N_BEAM_SAMPLES - number of beam samples

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Three inputs, linear range, recorded intensity and semantic class of the sample.
layout(rgba32f) uniform image2DArray sonarInput;

// One output - intensity for each bin/beam combination
layout(r32f) uniform image2D sonarOutput;

// One output - semantic class of the sample that won each bin/beam combination
layout(r16ui) uniform uimage2D sonarSegOutput;

uniform uvec2 beams; //beams1, beams2
uniform vec3 range; //min, max, step
uniform float gain;
uniform vec3 noiseSeed;
uniform vec2 noiseStddev;

// .x = intensity, .y = range, .z = class + 1 (0 means no valid sample)
// The class rides on the valid flag instead of a fourth component on purpose:
// this array is per-invocation private memory (N_BINS entries), so a vec4 would
// cost 33% more of it for a value that is only ever needed alongside the flag.
vec3 binHistogram[N_BINS];

#inject "gaussianNoise.glsl"

float sigmoid(float x)
{
    float t = (x - 0.6666667) * 18.0;
    return (0.5 * tanh(0.5 * t) + 0.5);
}

void main()
{
    uvec3 inDim = imageSize(sonarInput).xyz; //nViewBeams x nBeamSamples x nViews
    uint viewBeams = gl_GlobalInvocationID.y < inDim.z-1 ? beams.x : beams.y;

    if(gl_GlobalInvocationID.x < viewBeams)
    {
        for(uint i=0; i<N_BINS; ++i) //Initialize histogram buffer
            binHistogram[i] = vec3(0.0, range.y + 1.0, 0.0); // intensity, sentinel range, no valid sample

        ivec3 sampleCoord;
        sampleCoord.x = int(gl_GlobalInvocationID.x);
        sampleCoord.z = int(gl_GlobalInvocationID.y);

        for(int i=0; i<N_BEAM_SAMPLES; ++i) //For each vertical beam sample
        {
            sampleCoord.y = i;

            //Get sample value
            vec3 rangeIntensity = imageLoad(sonarInput, sampleCoord).xyz; //.z = class
            if(rangeIntensity.x < range.x || rangeIntensity.x >= range.y) //Outside valid range?
                continue;

            //Compute bin and select best sample (closest range, then highest intensity)
            float factor = float(i)/(float(N_BEAM_SAMPLES-1));
            uint bin = uint(floor((rangeIntensity.x - range.x)/range.z));
            float weightedIntensity = rangeIntensity.y * smoothstep(0.0, 0.2, factor) * (1.0 - smoothstep(0.8, 1.0, factor)); //Lobe intensity correction

            // Priority: 1) Closest range first, 2) Highest intensity if range is equal
            if(binHistogram[bin].z == 0.0 || rangeIntensity.x < binHistogram[bin].y ||
               (abs(rangeIntensity.x - binHistogram[bin].y) < 0.001 && weightedIntensity > binHistogram[bin].x))
            {
                binHistogram[bin].x = weightedIntensity;
                binHistogram[bin].y = rangeIntensity.x;
                binHistogram[bin].z = rangeIntensity.z + 1.0; // Mark as valid, carrying the winner's class
            }
        }

        //Compute and store bin values
        vec2 noiseCoord;
        noiseCoord.x = float(sampleCoord.x*(sampleCoord.z+1))/float(viewBeams * (inDim.z+1));
        float mulNoise = gaussian(noiseCoord.xx, noiseSeed, noiseStddev.x, 1.0);
        uint globalBeam = gl_GlobalInvocationID.x + beams.x * gl_GlobalInvocationID.y;

        for(uint i=0; i<N_BINS; ++i)
        {
            noiseCoord.y = i/float(N_BINS-1);
            float data = gain * gaussian(-noiseCoord.xy, noiseSeed, noiseStddev.y, 0.0); //Additive noise (Gaussian background noise)
            if(binHistogram[i].z > 0.0) // Check valid flag instead of count
                data += gain * binHistogram[i].x * mulNoise; //Signal + multiplicative noise (Gaussian beam gain noise)
            //data += data * rand(vec2(noiseSeed.x * i, noiseSeed.x * globalBeam)) * 0.5; // Speckle noise (Uniform multiplicative noise)
            imageStore(sonarOutput, ivec2(globalBeam, N_BINS-1-i), vec4(data));
            //Segmentation label - no noise, no gain, same bin flip so it stays pixel aligned with the intensity image
            uint segClass = binHistogram[i].z > 0.0 ? uint(binHistogram[i].z - 1.0) : 0u;
            imageStore(sonarSegOutput, ivec2(globalBeam, N_BINS-1-i), uvec4(segClass));
        }
    }
}